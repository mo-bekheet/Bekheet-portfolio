# Public — safe to expose in the browser bundle
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Cloudflare R2 Image Storage (public - safe for browser bundle)
VITE_R2_ACCOUNT_ID=your_account_id
VITE_R2_BUCKET_NAME=bekheet-portfolio-media
VITE_R2_PUBLIC_DOMAIN=https://images.bekheet.com

# Server-side only (set these in Netlify/Vercel dashboard, NEVER with a VITE_ prefix)
GEMINI_API_KEY=your_gemini_key_here
DATABASE_PASSWORD=

# R2 Upload (server-side only)
R2_ACCOUNT_ID=your_account_id
R2_BUCKET_NAME=bekheet-portfolio-media
R2_API_TOKEN=access_key:secret_key
R2_PUBLIC_DOMAIN=https://images.bekheet.com

# Seed script admin login (local only)
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=
